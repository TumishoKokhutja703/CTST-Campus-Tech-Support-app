<?xml version="1.0" encoding="utf-8"?>
<!-- Ticket Detail screen — shows full info about one ticket -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <!-- Header bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/nav_header_bg" android:padding="20dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tvBack" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="←"
            android:textSize="20sp" android:textColor="@color/white"
            android:layout_marginEnd="12dp"/>
        <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="#TKT-001"
            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/white"/>
    </LinearLayout>

    <!-- Ticket content area -->
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Ticket details will appear here."
                android:textSize="14sp" android:textColor="@color/muted"
                android:padding="20dp" android:gravity="center"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
