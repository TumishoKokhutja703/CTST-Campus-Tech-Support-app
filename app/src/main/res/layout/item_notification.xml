<?xml version="1.0" encoding="utf-8"?>
<!-- One row in the notifications RecyclerView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Coloured dot: blue = unread, grey = read -->
    <View android:id="@+id/dotView"
        android:layout_width="10dp" android:layout_height="10dp"
        android:layout_marginEnd="12dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <!-- Notification message -->
        <TextView android:id="@+id/tvMessage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="@color/text_primary"
            android:layout_marginBottom="3dp"/>
        <!-- Time of notification -->
        <TextView android:id="@+id/tvTime"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/muted"/>
    </LinearLayout>
</LinearLayout>
