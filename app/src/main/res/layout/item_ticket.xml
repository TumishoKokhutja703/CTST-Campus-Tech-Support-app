<?xml version="1.0" encoding="utf-8"?>
<!-- One ticket row in the RecyclerView list -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp" app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Left: ticket info -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">

            <!-- Ticket reference number -->
            <TextView android:id="@+id/tvRef"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textStyle="bold"
                android:textColor="@color/navy_light" android:layout_marginBottom="3dp"/>

            <!-- Short description (truncated to 1 line) -->
            <TextView android:id="@+id/tvDesc"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="1" android:ellipsize="end"
                android:layout_marginBottom="4dp"/>

            <!-- Category · Priority · Date -->
            <TextView android:id="@+id/tvMeta"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/muted"/>
        </LinearLayout>

        <!-- Right: status badge with coloured background -->
        <TextView android:id="@+id/tvStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:textStyle="bold"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
