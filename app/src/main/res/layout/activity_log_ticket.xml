<?xml version="1.0" encoding="utf-8"?>
<!-- Log Ticket screen — form for submitting a new support ticket -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <!-- Header row with back arrow and title -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="8dp" android:layout_marginBottom="20dp">
            <TextView android:id="@+id/tvBack" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="← Back"
                android:textSize="14sp" android:textColor="@color/navy_light"
                android:textStyle="bold" android:layout_marginEnd="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Log a Ticket" android:textSize="18sp"
                android:textStyle="bold" android:textColor="@color/navy"/>
        </LinearLayout>

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" app:cardCornerRadius="18dp"
            app:cardElevation="4dp" app:cardBackgroundColor="@color/surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="22dp">

                <!-- Section: Issue Details -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ISSUE DETAILS" android:textSize="10sp"
                    android:textStyle="bold" android:textColor="@color/muted"
                    android:layout_marginBottom="10dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Category" android:textSize="12sp"
                    android:textStyle="bold" android:textColor="@color/muted"/>
                <Spinner android:id="@+id/spinnerCategory" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp" android:background="@drawable/input_background"
                    android:paddingStart="10dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Device Type" android:textSize="12sp"
                    android:textStyle="bold" android:textColor="@color/muted"/>
                <Spinner android:id="@+id/spinnerDevice" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp" android:background="@drawable/input_background"
                    android:paddingStart="10dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Priority" android:textSize="12sp"
                    android:textStyle="bold" android:textColor="@color/muted"/>
                <Spinner android:id="@+id/spinnerPriority" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp" android:background="@drawable/input_background"
                    android:paddingStart="10dp"/>

                <!-- Section: Location -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LOCATION" android:textSize="10sp"
                    android:textStyle="bold" android:textColor="@color/muted"
                    android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/etLocation" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginBottom="14dp"
                    android:background="@drawable/input_background"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:hint="e.g. Lab 3B, Room 101" android:inputType="text"
                    android:textSize="14sp" android:textColor="@color/text_primary"
                    android:textColorHint="@color/muted"/>

                <!-- Section: Description -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DESCRIPTION" android:textSize="10sp"
                    android:textStyle="bold" android:textColor="@color/muted"
                    android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/etDescription" android:layout_width="match_parent"
                    android:layout_height="120dp" android:layout_marginBottom="4dp"
                    android:background="@drawable/input_background"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp"
                    android:hint="Describe the issue in detail..." android:inputType="textMultiLine"
                    android:gravity="top" android:textSize="14sp"
                    android:textColor="@color/text_primary" android:textColorHint="@color/muted"/>

                <!-- Character counter -->
                <TextView android:id="@+id/tvCharCount" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="0 / 500"
                    android:textSize="11sp" android:textColor="@color/muted"
                    android:gravity="end" android:layout_marginBottom="10dp"/>

                <!-- Error message -->
                <TextView android:id="@+id/tvError" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text=""
                    android:textSize="12sp" android:textColor="@color/red"
                    android:layout_marginBottom="10dp"/>

                <!-- Buttons -->
                <Button android:id="@+id/btnSubmit" android:layout_width="match_parent"
                    android:layout_height="52dp" android:text="Submit Ticket"
                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/white" android:background="@drawable/btn_primary"
                    android:stateListAnimator="@null"/>
                <Button android:id="@+id/btnCancel" android:layout_width="match_parent"
                    android:layout_height="52dp" android:text="Cancel"
                    android:textSize="14sp" android:textColor="@color/navy"
                    android:background="@drawable/btn_outline"
                    android:stateListAnimator="@null" android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
